{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kmi",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "GIVEBUTTER_API_KEY",
      "GIVEBUTTER_WEBHOOK_SECRET"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/webhooks/*", "/health"]
  }
}
